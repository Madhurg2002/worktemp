# Example environment file — copy to `.env` and adjust as needed.
# All values are non-secret; the app needs no API keys to run.

# Port the server binds to. Hosting previews inject this automatically;
# locally it falls back to API_PORT, then 3001.
PORT=3001

# Port for the API server during `npm run dev`, where the Vite dev server
# (default 5173) proxies /api requests to it.
API_PORT=3001
